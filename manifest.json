{
  "manifest_version": 3,
  "name": "Voice",
  "version": "1.0.0",
  "description": "Speak to fill any input or textarea instantly without API keys.",
  "permissions": [
    "activeTab"
  ],
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_title": "Voice",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle-speech": {
      "suggested_key": {
        "default": "Alt+V"
      },
      "description": "Toggle voice typing"
    }
  }
}